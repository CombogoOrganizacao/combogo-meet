{
  "name": "meu-app-rooms",
  "main": "src/room.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "RoomServer", "class_name": "RoomServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomServer"] }],
  "vars": {
    "API_FINALIZE_URL": "https://combogo-meet.vercel.app/rooms/finalize"
  }
}